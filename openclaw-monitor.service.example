[Unit]
Description=OpenClaw Monitor (agent/task dashboard)
After=network.target

[Service]
Type=simple
# Replace __APP_DIR__ with the absolute path of the repo and __NODE__ with the node binary (>= 22.5).
# `install.sh` generates this file automatically.
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=PORT=3200
# Listens on loopback by default: the dashboard exposes the content of the requests sent
# to the agents. Only switch to 0.0.0.0 on a trusted network.
Environment=HOSTNAME=127.0.0.1
Environment=NODE_OPTIONS=--max-old-space-size=320
# Uncomment to mask all business content (screenshots, demos):
# Environment=MONITOR_REDACT=1
ExecStart=__NODE__ __APP_DIR__/.next/standalone/server.js
Restart=always
RestartSec=5
# Memory guardrails: useful on a small machine that already hosts the gateway.
MemoryHigh=400M
MemoryMax=600M
CPUWeight=30
Nice=5

[Install]
WantedBy=default.target
